{
  "name": "page-mascot",
  "version": "0.1.0",
  "description": "Mascot Studio: customize, preview, and export interactive React mascots.",
  "license": "MIT",
  "author": "Kamran Ahmed",
  "homepage": "https://koboyo.com/page-mascot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nilbuild/page-mascot.git"
  },
  "keywords": [
    "mascot",
    "avatar",
    "react",
    "cursor",
    "sprite",
    "portfolio"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "sync:skill": "cp src/mascot.tsx skills/page-mascot/mascot.tsx",
    "check:skill": "diff -q src/mascot.tsx skills/page-mascot/mascot.tsx",
    "build": "tsc -p tsconfig.build.json && npm run sync:skill",
    "build:site": "npm run check:skill && npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "npm run build:site && npx wrangler deploy",
    "prepack": "npm run build",
    "test": "node scripts/check-studio.mjs",
    "format": "prettier --write site src scripts index.html vite.config.ts README.md package.json && npm run sync:skill"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "fflate": "^0.8.3",
    "oxlint": "^1.79.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
